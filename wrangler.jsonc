// Cloudflare Workers config, used by `npx wrangler deploy` in Workers Builds.
{
  "name": "games",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  // Builds dist/ before deploying. Workers Builds has no Deno installed, so it
  // falls back to the pinned `deno` npm package.
  "build": {
    "command": "sh -c 'if command -v deno >/dev/null; then deno task build; else npx --yes deno@2.9.6 task build; fi'"
  },
  // Only tells Wrangler's bundler to compile JSX for React's automatic
  // runtime; Deno type-checks with deno.json.
  "tsconfig": "./tsconfig.worker.json",
  "assets": {
    // Everything here is public: the platform's assets and every game build.
    "directory": "./dist",
    "binding": "ASSETS",
    // The Worker routes every request (catalog, play pages, redirects, and
    // 404s) and fetches files from ASSETS itself.
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
  },
  "migrations": [
    { "tag": "v1-game-rooms", "new_sqlite_classes": ["GameRoom"] }
  ],
  // Preview bindings are explicit; each branch gets isolated room storage.
  "previews": {
    "durable_objects": {
      "bindings": [{ "name": "ROOMS", "class_name": "GameRoom" }]
    }
  }
}
