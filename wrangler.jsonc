// Cloudflare Workers config, used by `npx wrangler deploy` in Workers Builds.
{
  "name": "games",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // The repo root, filtered down to static/ and games/ by .assetsignore.
    "directory": ".",
    "binding": "ASSETS",
    // The Worker routes every request (landing page, redirects, coming-soon
    // and 404 pages) and fetches files from ASSETS itself.
    "run_worker_first": true
  },
  // Required by `npx wrangler preview`, which Workers Builds runs for
  // non-production branches (PRs). Empty means previews inherit everything
  // above.
  "previews": {}
}
