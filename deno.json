{
  "workspace": [
    "./games/gold-miner"
  ],
  "nodeModulesDir": "auto",
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "jsxImportSourceTypes": "@types/react",
    "lib": [
      "deno.ns",
      "dom",
      "dom.iterable",
      "esnext"
    ]
  },
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno run -A npm:vite build && deno run --allow-read --allow-write=dist --allow-run scripts/build_games.ts",
    "start": "deno run --allow-net --allow-read=. --allow-env main.ts",
    "test": "deno test --allow-read=. --allow-env",
    "lint": "deno run --allow-read --allow-env --allow-run npm:@biomejs/biome lint --error-on-warnings"
  },
  "imports": {
    "@biomejs/biome": "npm:@biomejs/biome@2.5.15",
    "@std/assert": "jsr:@std/assert@1",
    "@std/http": "jsr:@std/http@^1.1.4",
    "@types/react": "npm:@types/react@19.3.0",
    "@types/react-dom": "npm:@types/react-dom@19.3.0",
    "@vitejs/plugin-react": "npm:@vitejs/plugin-react@6.1.2",
    "react": "npm:react@19.3.0",
    "react-dom": "npm:react-dom@19.3.0",
    "vite": "npm:vite@8.3.4"
  }
}
